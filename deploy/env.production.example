# Copy to deploy/.env.production and replace every value marked CHANGE_ME.
# `node deploy/init-env.mjs` generates the random values for you.
#
# This file is read by docker compose (env_file) and by the API/CMS containers.
# It is gitignored. Never commit the real file.

COMPOSE_PROJECT_NAME=rigel
ACME_EMAIL=hello@askrigel.com

POSTGRES_USER=rigel
POSTGRES_PASSWORD=CHANGE_ME_64_HEX
POSTGRES_DB=rigel
POSTGRES_CMS_DB=rigel_cms

JWT_SECRET=CHANGE_ME_96_HEX
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
APP_URL=https://askrigel.com
API_URL=https://api.askrigel.com
ALLOWED_ORIGINS=https://askrigel.com,https://www.askrigel.com,https://admin.askrigel.com

# Optional: set to send verification, reset, and contact mail through Resend.
RESEND_API_KEY=
MAIL_FROM="Rigel <hello@askrigel.com>"
CONTACT_TO=hello@askrigel.com
DATA_DIR=/data
DATABASE_SSL=false

# Optional LLM gateway. Leave LLM_BASE_URL/LLM_API_KEY blank to keep it disabled.
LLM_BASE_URL=
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODELS=
LLM_INPUT_MICROS_PER_MILLION=500000
LLM_OUTPUT_MICROS_PER_MILLION=1500000
LLM_DAILY_MICROS=2000000
LLM_MAX_OUTPUT_TOKENS=8192

# Optional public-site services.
GRAVITY_API_KEY=
GRAVITY_PRODUCTION=false
TURNSTILE_SECRET=
ENROLL_TOKEN=
REQUIRE_DEVICE=false

# Private machine-to-machine relay. Generate distinct values with 32 random bytes each.
RIGEL_RELAY_TOKEN=CHANGE_ME_43_CHAR_BASE64URL
MUSE_RELAY_TOKEN=CHANGE_ME_43_CHAR_BASE64URL

PAYLOAD_SECRET=CHANGE_ME_64_HEX
PAYLOAD_PUBLIC_SERVER_URL=https://admin.askrigel.com
PAYLOAD_ADMIN_EMAIL=hello@askrigel.com
PAYLOAD_ADMIN_PASSWORD=CHANGE_ME_48_HEX

# Public Firebase web config used by the existing web reader and site build.
RIGEL_FIREBASE_PROJECT_ID=
RIGEL_FIREBASE_API_KEY=
RIGEL_FIREBASE_AUTH_DOMAIN=
RIGEL_CMS_URL=

TZ=UTC
