{
	email {$ACME_EMAIL}
	admin off
}

(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

askrigel.com, www.askrigel.com {
	import site_headers
	root * /srv/site
	encode zstd gzip

	@immutable path /shots/* /constellations/* /fonts/*
	header @immutable Cache-Control "public, max-age=86400"
	header /app/config.js Cache-Control "no-store"
	header /app/app.js Cache-Control "public, max-age=3600"
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com https://www.googletagmanager.com https://www.google.com; connect-src 'self' https://api.askrigel.com https://api.github.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.gstatic.com https://apis.google.com https://accounts.google.com https://www.googleapis.com https://*.firebaseapp.com https://*.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://www.google.com https://rigel-25128-default-rtdb.firebaseio.com; frame-src https://*.firebaseapp.com https://apis.google.com https://accounts.google.com https://www.google.com https://recaptcha.google.com; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com https://api.trygravity.ai https://trygravity.ai https://*.trygravity.ai https://trygravity.com https://*.trygravity.com; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

	# The Payload admin lives at /admin, with its API and Next.js assets on this hostname.
	@cms_routes path /admin /admin/* /_next/* /api/*
	header @cms_routes -Content-Security-Policy

	# Site-local catalogue metadata avoids a browser request to Firebase Realtime Database.
	handle /api/catalog-meta {
		rewrite * /catalog/v1/meta.json
		reverse_proxy https://rigel-25128-default-rtdb.firebaseio.com
	}

	# Temporary bridge until the Fastify public routes replace these two Firebase functions.
	handle /api/contact {
		rewrite * /contact
		reverse_proxy https://us-central1-rigel-25128.cloudfunctions.net
	}

	handle /api/gravity-ad {
		rewrite * /gravityAd
		reverse_proxy https://us-central1-rigel-25128.cloudfunctions.net
	}

	handle @cms_routes {
		reverse_proxy cms:3000
	}

	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

api.askrigel.com {
	import site_headers
	reverse_proxy api:8080
}

admin.askrigel.com {
	import site_headers
	encode zstd gzip
	reverse_proxy cms:3000
}
