# Rigel — the variables the app reads from the process environment.
#
# Names only: real values live in Infisical (`bash scripts/dev.sh` runs the app through
# `infisical run --env=dev`, see INFISICAL.md) or in the OS keychain (`rigel keys set <provider>`).
# A `.env` here works too, but git ignores it — never commit one.

# Where index.db and blobs/ live. Empty means the per-user app-data directory.
# RIGEL_INDEX_DIR=

# The native agent's provider — any row of the adapter table: omniroute (default), openrouter,
# gemini, vertex, anthropic, openai, xai, groq, deepseek, mistral, together or fireworks.
# RIGEL_PROVIDER=omniroute

# Anthropic's Messages API. Empty means https://api.anthropic.com/v1. The key is the same
# ANTHROPIC_API_KEY the Claude Code harness reads, so one entry serves both.
# RIGEL_ANTHROPIC_BASE_URL=

# Gemini API base. Empty means https://generativelanguage.googleapis.com/v1beta/openai.
# RIGEL_GEMINI_BASE_URL=

# Vertex AI: the project and location the endpoint is billed to. The credential is a token, not a
# key — VERTEX_ACCESS_TOKEN below, `rigel keys set vertex`, or `gcloud auth print-access-token`.
# Empty location means `global`. RIGEL_VERTEX_BASE_URL skips both.
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1

# The local OmniRoute router. Empty means http://127.0.0.1:20128/v1.
# RIGEL_OMNIROUTE_URL=http://127.0.0.1:20128/v1

# One base-URL override per row of the table, for a gateway that speaks the same contract:
# RIGEL_OPENROUTER_BASE_URL, RIGEL_OPENAI_BASE_URL, RIGEL_XAI_BASE_URL, RIGEL_GROQ_BASE_URL,
# RIGEL_DEEPSEEK_BASE_URL, RIGEL_MISTRAL_BASE_URL, RIGEL_TOGETHER_BASE_URL,
# RIGEL_FIREWORKS_BASE_URL.

# Where the Hyper bridge reads the token file Rigel handed it. Empty means %APPDATA%\Rigel\hyper-bridge.json.
# RIGEL_HYPER_CONFIG=

# Rigel Cloud (optional): the Firebase project you own. `rigel cloud configure` writes cloud.json
# instead; these are the headless equivalent. The three *BASE overrides exist for the local test
# server (crates/rigel-core/tests/cloud.rs) and for a gateway, not for a normal install.
# RIGEL_FIREBASE_PROJECT_ID=
# RIGEL_FIREBASE_API_KEY=
# RIGEL_FIREBASE_IDENTITY_BASE=
# RIGEL_FIREBASE_TOKEN_BASE=
# RIGEL_FIREBASE_FIRESTORE_BASE=

# GitHub token for `rigel skills index`; raises the quota from 60 to 5,000 requests/hour.
RIGEL_GITHUB_TOKEN=
GITHUB_TOKEN=

# Provider and harness keys. Prefer the keychain: `rigel keys set <provider>`.
OMNIROUTE_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Vertex AI has no API key: this is a short-lived OAuth access token.
VERTEX_ACCESS_TOKEN=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
