# Copy to functions/.env before deploying. This file is not a secret; the client allowlist is
# a Secret Manager secret (`firebase functions:secrets:set RIGEL_ATTEST_CLIENTS`).

# Project settings -> Your apps -> the web app id, e.g. 1:1234567890:web:abcdef...
RIGEL_FIREBASE_APP_ID=

# Optional: change the token-bucket limits. A client fetches one token an hour, so the default
# burst is deliberately larger than that to survive a restart or two.
# RIGEL_ATTEST_CLIENT_PER_HOUR=12
# RIGEL_ATTEST_CLIENT_BURST=4
# RIGEL_ATTEST_IP_PER_HOUR=60
# RIGEL_ATTEST_IP_BURST=12
