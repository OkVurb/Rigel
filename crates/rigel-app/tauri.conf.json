{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rigel",
  "version": "0.1.3",
  "identifier": "dev.rigel.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rigel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Rigel contributors",
    "copyright": "© 2026 Rigel contributors",
    "category": "DeveloperTool",
    "shortDescription": "One window for several coding agents on one project.",
    "longDescription": "Rigel runs Codex, Claude Code, Cursor, Cline and its own coordinator against one working tree, and keeps the transcript, the claims, the merged diff and the bill in one place. Session logs stay local. Installs show their exact command first. Closing the window keeps the agents running in the tray. Updates check GitHub at launch and can be turned off in Settings.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      },
      "nsis": {
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "resources/sidecar/": "sidecar/",
      "resources/update-pubkey.txt": "update-pubkey.txt"
    }
  }
}
