{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rigel",
  "version": "0.1.0",
  "identifier": "dev.rigel.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rigel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Rigel contributors",
    "copyright": "\u00a9 2026 Rigel contributors",
    "category": "DeveloperTool",
    "shortDescription": "One window for several coding agents on one project.",
    "longDescription": "Rigel runs Codex, Claude Code, Cursor, Cline and its own coordinator against one working tree, and keeps the transcript, the claims, the merged diff and the bill in one place. Session logs stay local. Installs show their exact command first. Updates are off until you turn them on.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    }
  }
}
