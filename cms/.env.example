# Local authoring uses SQLite. A hosted deployment uses a Postgres URL here.
# DATABASE_URL=postgres://user:password@host:5432/rigel
DATABASE_URL=file:./cms.db
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# The Firebase project the admin's Cloud links open. Defaults to the Rigel project.
# RIGEL_FIREBASE_PROJECT_ID=rigel-25128

# Used once by `npm run seed` to create the first admin user.
PAYLOAD_ADMIN_EMAIL=content@rigel.local
PAYLOAD_ADMIN_PASSWORD=replace-with-a-local-admin-password
