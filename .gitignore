# deps
node_modules/
.tools/

# build output
dist/
dist-ssr/
*.tsbuildinfo
target/

# Playwright: the browser's traces and reports are local artifacts
ui/test-results/
ui/playwright-report/

# Rust: session databases are local by design (see docs/handoff.md §6)
.rigel/
*.db-wal
*.db-shm

# local
.env
.env.*
!.env.example
*.log

# AgentMail list output contains message bodies and verification codes; never repository state
/am_list.json

# Firebase CLI: the project alias and the CLI's cache are per-machine, not repository state
.firebaserc
.firebase/
.DS_Store
Thumbs.db

# Apple's Xcode.xip is multiple GB and only needed to build the Darwin SDK once
*.xip

# generated screenshots stay out of history except the ones we reference
screenshots/*.tmp.png

# The built Chat sidecar: ~99 MB of pinned source and an embedded Python runtime,
# produced by scripts/sidecar/build-agentchat.py. Never committed; the placeholder
# keeps Tauri's resource path valid on a clean checkout, where the sidecar is optional.
crates/rigel-app/resources/sidecar/*
!crates/rigel-app/resources/sidecar/.gitkeep
vendor/cache/
__pycache__/
*.pyc

# Tauri build output
crates/rigel-app/gen/
vendor/

# Claude Code local settings (machine-specific approvals)
.claude/settings.local.json

# Local MCP wiring for the chat agents: absolute paths and per-machine agent ids
.mcp.json

# local README render check, not part of the repository
.preview/

# per-thread handoff note; crossing threads, never history
ACTIVE-WORK.md

# scratch space for local runs and one-off previews
/tmp/
