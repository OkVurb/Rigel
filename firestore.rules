rules_version = '2';

// Rigel Cloud — one account owns one subtree, and nobody else can read it.
//
// The app signs in with Firebase Authentication and talks to Firestore's REST API with the
// user's own ID token. Every document lives under `users/{uid}`, so the only rule needed is
// "the signed-in user is that uid". There is no shared collection and no anonymous access:
// a request without a valid ID token is denied, and a token for another account cannot name
// this subtree.
//
// Deploy with:  firebase deploy --only firestore:rules
// The document shape is in docs/cloud.md.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
